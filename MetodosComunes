package tarea2;

import java.util.InputMismatchException;
import java.util.Scanner;

public class MetodosComunes {

	private static Scanner sc = new Scanner(System.in);
	private static Scanner scDouble = new Scanner(System.in);
	private static Scanner scBoolean = new Scanner(System.in);
	private static Scanner scLetra = new Scanner(System.in);

	public static int introduceNumero(String txt) {

		int numero = 0;
		boolean rep = true;

		do {
			rep = true;
			try {
				System.out.println(txt);
				numero = sc.nextInt();
				if (numero < 0) {
					System.err.println("ERROR: El número tiene que ser mayor o igual que 0");
				} else {
					rep = false;
				}
			} catch (InputMismatchException e) {
				System.err.println("ERROR: Debes de introducir un número");
				sc.next();
			} catch (Exception e) {
				System.err.println("ERROR");
			}
		} while (rep);

		return numero;
	}

	public static String introduceLetra(String txt) {

		System.out.println(txt);
		String texto = scLetra.nextLine().trim();

		return texto;
	}

	public static double introducaDouble(String txt) {

		double numero = 0;
		boolean rep = true;

		do {
			rep = true;
			try {
				System.out.println(txt);
				numero = scDouble.nextDouble();
				if (numero < 0) {
					System.err.println("ERROR: El número tiene que ser mayor o igual que 0");
				} else {
					rep = false;
				}
			} catch (InputMismatchException e) {
				System.err.println("ERROR: Debes de introducir un número");
				scDouble.next();
			} catch (Exception e) {
				System.err.println("ERROR");
			}
		} while (rep);

		return numero;

	}

	public static boolean introduceBoolean(String txt) {
		boolean rep = true;
		boolean texto = false;

		do {
			rep = true;
			try {
				System.out.println(txt);
				texto = scBoolean.nextBoolean();
				rep = false;
			} catch (InputMismatchException e) {
				System.err.println("ERROR: Debes de introducir true o false");
				scBoolean.next();
			}
		} while (rep);

		return texto;
	}

}
